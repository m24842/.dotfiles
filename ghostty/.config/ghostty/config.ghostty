theme = Rose Pine

macos-icon = glass
macos-icon-frame = chrome

auto-update = check

window-padding-x = 12
window-padding-y = 6
window-padding-color = background

font-size = 12
font-thicken = true
font-feature = -calt

cursor-style-blink = false

clipboard-read = allow
clipboard-write = allow

shell-integration-features = ssh-terminfo,ssh-env

