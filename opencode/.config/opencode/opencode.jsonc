{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "build",
    "update": "auto",
    "compaction": {
        "auto": true,
        "buffer": "15%",
        "keep": {
        "tokens": 20000
        }
    },
    "providers": {
        "cheapllm": {
            "name": "CheapLLM",
            "env": ["CHEAPLLM_API_KEY"],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": { "baseURL": "https://cheapllm.shop/v1" },
            "models": { "deepseek-v4.1-flash-1017": { "name": "DeepSeek V4.1 Flash" } }
        }
    },
}

